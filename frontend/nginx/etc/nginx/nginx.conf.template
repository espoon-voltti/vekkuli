user  nginx;
worker_processes  auto;

error_log  /dev/stderr notice;
pid        /nginx/nginx.pid;

{{ if eq (env.Getenv "DD_PROFILING_ENABLED" "false") "true" }}
load_module modules/ngx_otel_module.so;
{{ end }}

events {
    worker_connections  1024;
}

http {
{{ if eq (env.Getenv "DD_PROFILING_ENABLED" "false") "true" }}
    otel_exporter {
        endpoint {{ .Env.DD_AGENT_HOST }}:4317;
        interval 5s;
        batch_size 512;
        batch_count 4;
    }

    otel_trace on;
    otel_trace_context propagate;
    # Datadog Unified Service Tagging: service.name / service.version /
    # deployment.environment as resource attrs (env maps to Datadog `env`).
    # http.route and http.user_agent are auto-populated by the module, so we do
    # not set them here (a custom otel_span_attr would add a duplicate key with a
    # high-cardinality $uri value, degrading route aggregation).
    otel_service_name "vekkuli-proxy";
    otel_resource_attr "service.version" "{{ .Env.APP_COMMIT }}";
    otel_resource_attr "deployment.environment" "{{ .Env.NGINX_ENV }}";
{{ end }}

    include       /nginx/config/mime.types;
    default_type  application/octet-stream;

    # Temp paths for read-only filesystem compatibility
    client_body_temp_path /nginx/client_body;
    proxy_temp_path       /nginx/proxy;
    fastcgi_temp_path     /nginx/fastcgi;
    uwsgi_temp_path       /nginx/uwsgi;
    scgi_temp_path        /nginx/scgi;

    # Trace correlation is emitted as OTLP spans by ngx_otel_module (see above),
    # not injected into access logs; the OTel trace id is not a Datadog id.
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /dev/stdout main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;
    client_header_timeout 70s;

    #gzip  on;

    include /nginx/config/conf.d/*.conf;
}
